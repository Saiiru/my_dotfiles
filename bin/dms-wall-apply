#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
    printf 'Usage: %s <wallpaper-path>\n' "${0##*/}" >&2
    exit 1
fi

img="$1"

if [[ ! -f "$img" ]]; then
    printf 'dms-wall-apply: wallpaper not found: %s\n' "$img" >&2
    exit 2
fi

# Ensure the wallpaper daemon is running before changing the image.
if ! pgrep -x swww-daemon >/dev/null 2>&1; then
    swww-daemon &
    sleep 0.2
fi

swww img "$img" --transition-type any --transition-duration 0.8 --transition-bezier .43,0,.18,1

qs ipc call colorpalette extract "$img"
qs ipc call colorpalette apply
