# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Ghostty — Red Hood Cyberpunk Theme
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Cursor
cursor-style = block
cursor-style-blink = false
adjust-cursor-height = -20%

# Fonts
font-family = "GeistMono Nerd Font"
font-family-bold = "GeistMono Nerd Font Bold"
font-family-italic = "GeistMono Nerd Font Italic"
font-family-bold-italic = "GeistMono Nerd Font Bold Italic"
font-size = 11.5

# Window behaviour
window-decoration = false
window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
window-theme = dark
confirm-close-surface = false
quit-after-last-window-closed = false

# Transparency & blur
background-opacity = 0.88
background-blur-radius = 8

# Colors
background = #0a0b0d
foreground = #e6edf3
palette = 0=#0a0b0d
palette = 1=#dc143c
palette = 2=#22e3b3
palette = 3=#facc15
palette = 4=#22d3ee
palette = 5=#7c3aed
palette = 6=#ee79d1
palette = 7=#e6edf3
palette = 8=#1f232a
palette = 9=#ff073a
palette = 10=#22e3b3
palette = 11=#facc15
palette = 12=#22d3ee
palette = 13=#a98bff
palette = 14=#ee79d1
palette = 15=#ffffff
selection-background = #dc143c
selection-foreground = #0a0b0d
cursor-color = #ff073a
cursor-text = #0a0b0d

# Behaviour
copy-on-select = clipboard
bold-is-bright = true
shell-integration-features = no-cursor,sudo

# Performance flags (Wayland)
renderer-late-present = true

# Keybindings
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+0=reset_font_size
keybind = ctrl+shift+p=command_palette

# Include optional overrides if present
include ~/.config/ghostty/local.conf
