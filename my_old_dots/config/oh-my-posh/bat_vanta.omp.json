{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "session",
          "style": "plain",
          "foreground": "#22D3EE",
          "foreground_templates": ["{{ if .Root }}#EF4444{{ end }}"],
          "properties": { "display_host": true, "cache_duration": "none" },
          "template": "<#7C3AED>\u250c\u2500\u2500(</>{{ .UserName }}{{ if .Root }}💀{{ else }} 󰙨 {{ end }}{{ .HostName }}<#7C3AED>)"
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#CDD6F4",
          "properties": { "style": "full", "folder_separator_icon": "<#7C3AED>/</>", "cache_duration": "none" },
          "template": "<#7C3AED>-[</>󰉋 {{ .Path }}<#7C3AED>]>"
        },
        { "type": "python", "style": "plain", "foreground": "#10B981",
          "properties": { "fetch_version": true, "fetch_virtual_env": true, "cache_duration": "none" },
          "template": "<#7C3AED>-[</> {{ if .Venv }}{{ .Venv }}{{ else if .Pyenv }}{{ .Pyenv }}{{ else }}{{ .Full }}{{ end }}<#7C3AED>]>"},
        { "type": "node", "style": "plain", "foreground": "#FACC15",
          "properties": { "fetch_version": true, "cache_duration": "none" },
          "template": "<#7C3AED>-[</> {{ .Full }}<#7C3AED>]>" },
        { "type": "go", "style": "plain", "foreground": "#00ADD8",
          "properties": { "fetch_version": true, "cache_duration": "none" },
          "template": "<#7C3AED>-[</> {{ .Full }}<#7C3AED>]>" },
        { "type": "java", "style": "plain", "foreground": "#FF2D20",
          "properties": { "fetch_version": true, "cache_duration": "none" },
          "template": "<#7C3AED>-[</> {{ .Full }}<#7C3AED>]>" },
        { "type": "git", "style": "plain", "foreground": "#EE79D1",
          "properties": { "fetch_status": true, "fetch_upstream_icon": true, "branch_icon": "", "cache_duration": "none" },
          "template": "<#7C3AED>-[</> {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} {{ end }}{{ if .Staging.Changed }} {{ end }}{{ if .Ahead }} {{ .Ahead }}{{ end }}{{ if .Behind }} {{ .Behind }}{{ end }}<#7C3AED>]>" }
      ]
    },
    { "type": "prompt", "alignment": "right" },
    { "type": "prompt", "alignment": "left", "newline": true,
      "segments": [
        { "type": "text", "style": "plain", "foreground": "#7C3AED",
          "properties": { "cache_duration": "none" },
          "template": "<#7C3AED>\u2514\u2500</>{{ if .Root }}<#EF4444>#</>{{ else }}${{ end }} " }
      ]
    }
  ]
}

