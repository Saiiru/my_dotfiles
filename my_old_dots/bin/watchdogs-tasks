#!/usr/bin/env bash
set -euo pipefail

TASK_BIN=${TASK_BIN:-task}
POMODORO_BIN="$HOME/dotfiles/config/tmux/scripts/pomodoro.sh"

command -v "$TASK_BIN" >/dev/null 2>&1 || { echo 'taskwarrior não instalado.' >&2; exit 1; }
command -v fzf >/dev/null 2>&1 || { echo 'fzf é necessário para o task hub.' >&2; exit 1; }
command -v jq >/dev/null 2>&1 || { echo 'jq é necessário para o task hub.' >&2; exit 1; }

print_header() {
  printf '\n Watch_Dogs Tasks TUI ⟶ [enter] info · [ctrl-s] start · [ctrl-t] stop · [ctrl-d] done · [ctrl-b] pomodoro · [ctrl-n] nova · [ctrl-r] refresh · [esc] sair\n\n'
}

fetch_rows() {
  "$TASK_BIN" +PENDING export 2>/dev/null |
    jq -r '.[] | select(.status=="pending") | "\(.id)\t\(.urgency // 0 | tonumber | round)\t\(.project // "—")\t\(.description)"'
}

add_task() {
  printf 'Descrição da nova tarefa: '
  if ! IFS= read -r desc || [[ -z "$desc" ]]; then
    return
  fi
  printf 'Projet(o) (opcional): '
  IFS= read -r proj || true
  if [[ -n "$proj" ]]; then
    $TASK_BIN add project:"$proj" "$desc"
  else
    $TASK_BIN add "$desc"
  fi
  sleep 0.4
}

start_pomodoro() {
  local task_id="$1"
  if [[ -x "$POMODORO_BIN" ]]; then
    "$POMODORO_BIN" start 25 "$task_id"
  else
    notify-send 'Pomodoro' "Inicie manualmente: pomodoro.sh start 25 $task_id" >/dev/null 2>&1 || true
  fi
}

show_info() {
  local id="$1"
  $TASK_BIN "$id" info | less -R
}

loop() {
  while true; do
    clear
    mapfile -t rows < <(fetch_rows)
    if [[ ${#rows[@]} -eq 0 ]]; then
      echo 'Nenhuma tarefa pendente. [enter] para atualizar · [n] nova tarefa · [q] sair'
      read -r answer
      case "$answer" in
        n|N)
          add_task
          continue
          ;;
        q|Q)
          break
          ;;
        *)
          continue
          ;;
      esac
    fi
    print_header
    local selection
    selection=$(printf '%s\n' "${rows[@]}" | fzf \
      --ansi --prompt='task ▷ ' \
      --bind='enter:accept,ctrl-s:accept-non-empty,ctrl-t:accept-non-empty,ctrl-d:accept-non-empty,ctrl-b:accept-non-empty,ctrl-n:abort,ctrl-r:abort,ctrl-q:cancel,esc:cancel' \
      --expect=enter,ctrl-s,ctrl-t,ctrl-d,ctrl-b,ctrl-r,ctrl-n,ctrl-q \
      --header='ctrl-n adiciona | ctrl-r atualiza' \
      --with-nth=1,3,4 \
      --preview-window='down:60%' \
      --preview='[[ {1} =~ ^[0-9]+$ ]] && task {1} info || echo sem seleção' || true)

    local key line id
    key=$(sed -n '1p' <<<"$selection")
    line=$(sed -n '2p' <<<"$selection")
    id=$(cut -f1 <<<"$line")

    case "$key" in
      ctrl-n)
        add_task
        continue
        ;;
      ctrl-r)
        continue
        ;;
      ctrl-q|"" )
        break
        ;;
      enter)
        if [[ -n "$id" ]]; then
          show_info "$id"
        fi
        ;;
      ctrl-s)
        [[ -n "$id" ]] && $TASK_BIN "$id" start > /dev/null && sleep 0.2
        ;;
      ctrl-t)
        [[ -n "$id" ]] && $TASK_BIN "$id" stop > /dev/null && sleep 0.2
        ;;
      ctrl-d)
        [[ -n "$id" ]] && $TASK_BIN "$id" done > /dev/null && sleep 0.2
        ;;
      ctrl-b)
        [[ -n "$id" ]] && start_pomodoro "$id"
        ;;
      *)
        ;;
    esac
  done
}

loop
