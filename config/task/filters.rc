# Context shortcuts
context.ops=project:ops
context.dev=project:dev

# Saved reports for tmux board
report.feed.description=Top urgency feed
report.feed.columns=urgency,project,description
report.feed.sort=urgency-
report.feed.filter=+PENDING

report.next.description=Next actions
report.next.columns=project,description
report.next.sort=project+
report.next.filter=+PENDING
