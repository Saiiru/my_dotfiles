# Taskwarrior :: Watch_Dogs baseline profile
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
data.location=~/.local/share/task
hooks=1
hooks.location=~/dotfiles/config/task/hooks
color=on
confirmation=off
uda.watch.type=string
uda.watch.label=Watch list flag
report.watch.description=Watch list
report.watch.columns=id,project,priority,description
report.watch.sort=priority-,urgency-
report.watch.filter=+PENDING +watch
report.watchdogs.description=Watch_Dogs overview
report.watchdogs.columns=id,start.relative,urgency,project,description
report.watchdogs.labels=ID,Started,Urg,Project,Description
report.watchdogs.sort=urgency-
report.watchdogs.filter=+PENDING

# Default context = none, but keep door open for "ops" context
context.none.description=All tasks

include ~/dotfiles/config/task/filters.rc
