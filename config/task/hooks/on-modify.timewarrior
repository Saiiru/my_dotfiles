#!/usr/bin/env python3
"""Taskwarrior ↔ Timewarrior glue for Watch_Dogs profile.

This hook listens to task start/stop transitions and mirrors them
into Timewarrior tags so Pomodoro + Task flows stay aligned.
"""
import json
import os
import shutil
import subprocess
import sys

TIMEW = os.environ.get("TIMEW", "timew")


def timew_available() -> bool:
    return shutil.which(TIMEW) is not None


def run_timew(args):
    try:
        subprocess.run([TIMEW] + args, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


def read_payload():
    old_line = sys.stdin.readline().strip()
    new_line = sys.stdin.readline().strip()
    old = json.loads(old_line) if old_line else {}
    new = json.loads(new_line) if new_line else {}
    return old, new


def main():
    old, new = read_payload()
    if not timew_available():
        sys.stdout.write(json.dumps(new))
        return

    status_old = old.get("status")
    status_new = new.get("status")
    started_old = bool(old.get("start"))
    started_new = bool(new.get("start"))

    task_uuid = new.get("uuid", "")[:8]
    project = new.get("project")
    tags = [f"task:{task_uuid}"]
    if project:
        tags.append(f"project:{project}")

    if status_new == "completed" and status_old != "completed":
        run_timew(["stop"])
    elif started_new and not started_old:
        run_timew(["start"] + tags)
    elif not started_new and started_old:
        run_timew(["stop"])

    sys.stdout.write(json.dumps(new))


if __name__ == "__main__":
    main()
