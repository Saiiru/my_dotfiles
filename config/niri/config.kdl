// Niri configuration — Workstation Ops edition
// Docs: https://github.com/YaLTeR/niri/wiki/Configuration:-Overview

environment {
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
    QT_QPA_PLATFORM "wayland"
    QT_AUTO_SCREEN_SCALE_FACTOR "1"
    ELECTRON_OZONE_PLATFORM_HINT "wayland"
    TERMINAL "ghostty"
    EDITOR "nvim"
}

input {
    keyboard {
        xkb {
            layout "br"
        }
        repeat-rate 35
        repeat-delay 350
    }
    touchpad {
        tap
        natural-scroll
    }
    focus-follows-mouse
}

output "DP-1" {
    transform "normal"
    position x=0 y=0
    scale 1.0
}

output "HDMI-A-1" {
    transform "normal"
    position x=1920 y=0
    scale 1.0
}

layout {
    gaps 8
    center-focused-column "on-overflow"
    preset-column-widths {
        proportion 0.33
        proportion 0.5
        proportion 0.67
    }
    default-column-width {
        proportion 0.55
    }
    border {
        off
    }
    focus-ring {
        width 2
        active-color "#4fd2ff"
        inactive-color "#22242d"
    }
    shadow {
        softness 30
        spread 6
        offset x=0 y=6
        color "#000a"
    }
    struts {
        left 0
        right 0
        top 0
        bottom 0
    }
    background-color "#0d0d16f5"
}

spawn-at-startup "bash" "-lc" "~/.config/niri/scripts/autostart.sh"

window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

window-rule {
    match app-id=r#"^(steam|pavucontrol|gnome-control-center)$"#
    open-floating true
}

window-rule {
    match app-id=r#"^firefox$"#
    match title=r#"^Picture-in-Picture$"#
    open-floating true
}

window-rule {
    match app-id=r#"^(ghostty|kitty|wezterm|com\.mitchellh\.ghostty)$"#
    draw-border-with-background false
}

binds {
    Mod+Return { spawn "ghostty"; }
    Mod+Shift+Return { spawn "kitty"; }
    Mod+Space { spawn "fuzzel"; }
    Mod+Shift+G { spawn "gamescope" "-f" "-w" "1920" "-h" "1080" "--" "steam" "-bigpicture"; }
    Mod+B { spawn "firefox"; }
    Mod+Shift+C { spawn "bash" "-lc" "cliphist list | fuzzel --dmenu | cliphist decode | wl-copy"; }
    Mod+Shift+L { spawn "dms" "ipc" "call" "lock" "lock"; }

    Mod+Q { close-window; }
    Mod+Shift+T { toggle-window-floating; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }

    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up { move-column-to-workspace-up; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }

    XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "-5%"; }
    XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "+5%"; }
    XF86AudioMute { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    Print { spawn "bash" "-lc" "grimblast save area ~/Pictures/Screenshots/grim-$(date +%s).png"; }
    Mod+Shift+S { spawn "bash" "-lc" "grimblast copy area"; }
}
