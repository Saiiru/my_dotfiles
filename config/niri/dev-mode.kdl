// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  NEON‑NIRI v2 · Development Overlay
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

layout {
    gaps 8
    default-column-width { proportion 0.60; }
    focus-ring {
        width 3
        active-color "#50fa7b"
    }
}

animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1100 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }
}

window-rule {
    match app-id="firefox|brave-browser"
    default-column-width { proportion 0.80; }
}

window-rule {
    match app-id="Code|code-oss|com.visualstudio.code"
    opacity 0.95
}

// Extend idle timeout for reading / research sessions
idle {
    timeout 1200
}
