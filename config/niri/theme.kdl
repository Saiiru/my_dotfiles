// ───────────────── Penumbra Theme ───────────────
// Paleta Night City + Batcaverna aplicada via include no config principal.
// Paleta de referência: bg0 #0a0a0a, bg1 #16161e, bg2 #1f1f28, bg3 #2a2a37,
// fg #c0caf5, fgSoft #a9b1d6, fgDim #565f89, accent #7aa2f7, accentAlt #7dcfff,
// danger #f7768e, warn #e0af68, ok #9ece6a, special #bb9af7, gold #ffc700.

layout {
  gaps 4
  center-focused-column "never"
  always-center-single-column
  default-column-display "tabbed"

  preset-column-widths {
    proportion 0.33333
    proportion 0.5
    proportion 0.66667
  }
  default-column-width { proportion 0.5; }

  preset-window-heights {
    proportion 0.33333
    proportion 0.5
    proportion 0.66667
  }

  focus-ring {
    width 1.5
    active-color "#7aa2f7"
    inactive-color "#565f89"
  }

  border {
    width 1.5
    active-color "#00f5ff"
    inactive-color "#0b0f1a"
  }

  shadow {
    on
    softness 30
    spread 5
    offset x=0 y=5
    color "#0a0a0acc"
  }

  tab-indicator {
    hide-when-single-tab
    place-within-column
    gap 5
    width 4
    length total-proportion=1.0
    position "right"
    gaps-between-tabs 2
    corner-radius 8
    active-color "#7aa2f7"
    inactive-color "#3b4261"
  }
}

overview {
  zoom 0.35
  backdrop-color "#050814"

  workspace-shadow {
    softness 30
    spread 18
    offset x=0 y=0
    color "rgba(0, 0, 0, 0.85)"
  }
}
