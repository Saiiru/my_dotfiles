#  NEON-NIRI v2 - ZSH CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

skip_global_compinit=1

source "${ZDOTDIR:-$HOME/.config/zsh}/env.zsh"

HISTFILE="${XDG_STATE_HOME}/zsh/history"
HISTSIZE=50000
SAVEHIST=50000
mkdir -p "$(dirname "$HISTFILE")"

setopt EXTENDED_HISTORY HIST_EXPIRE_DUPS_FIRST HIST_IGNORE_DUPS \
       HIST_IGNORE_SPACE HIST_VERIFY SHARE_HISTORY

autoload -Uz compinit
if [[ -n ${ZDOTDIR}/.zcompdump(#qN.mh+24) ]]; then
    compinit
else
    compinit -C
fi

setopt ALWAYS_TO_END AUTO_MENU COMPLETE_IN_WORD MENU_COMPLETE
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

bindkey -e
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down
bindkey '^[[3~' delete-char
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line

if command -v starship &>/dev/null; then
    eval "$(starship init zsh)"
else
    PROMPT='%F{cyan}%n@%m%f:%F{blue}%~%f %# '
fi

ZSH_AUTOSUGGEST_DIR="/usr/share/zsh/plugins/zsh-autosuggestions"
[[ -f "$ZSH_AUTOSUGGEST_DIR/zsh-autosuggestions.zsh" ]] && source "$ZSH_AUTOSUGGEST_DIR/zsh-autosuggestions.zsh"

ZSH_HISTORY_SUBSTRING_DIR="/usr/share/zsh/plugins/zsh-history-substring-search"
[[ -f "$ZSH_HISTORY_SUBSTRING_DIR/zsh-history-substring-search.zsh" ]] && source "$ZSH_HISTORY_SUBSTRING_DIR/zsh-history-substring-search.zsh"

ZSH_HIGHLIGHT_DIR="/usr/share/zsh/plugins/zsh-syntax-highlighting"
[[ -f "$ZSH_HIGHLIGHT_DIR/zsh-syntax-highlighting.zsh" ]] && source "$ZSH_HIGHLIGHT_DIR/zsh-syntax-highlighting.zsh"

source "${ZDOTDIR:-$HOME/.config/zsh}/aliases.zsh"
source "${ZDOTDIR:-$HOME/.config/zsh}/functions.zsh"

update_context_indicator() {
    local file="${XDG_STATE_HOME}/neon-niri/system-context"
    if [[ -f "$file" ]]; then
        local ctx=$(<"$file")
        case "$ctx" in
            DEV) export CONTEXT_INDICATOR="%F{cyan}[DEV]%f " ;;
            GAME) export CONTEXT_INDICATOR="%F{red}[GAME]%f " ;;
            *) export CONTEXT_INDICATOR="" ;;
        esac
    else
        export CONTEXT_INDICATOR=""
    fi
}
precmd_functions+=(update_context_indicator)

if [[ -o interactive ]]; then
    echo "╔═══════════════════════════════════════════════════════╗"
    echo "║        NEON-NIRI v2 - Arch + Niri + Quickshell       ║"
    echo "║               Welcome, $(whoami)!                        ║"
    echo "╚═══════════════════════════════════════════════════════╝"
    echo ""
    echo "Context: $(cat ${XDG_STATE_HOME}/neon-niri/system-context 2>/dev/null || echo 'UNKNOWN')"
    echo "Type 'niri-help' for keybindings and tips."
    echo ""
fi
