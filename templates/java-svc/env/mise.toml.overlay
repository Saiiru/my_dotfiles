[env]
JAVA_HOME = "{{env.HOME}}/.local/share/mise/installs/java/__JAVA_VERSION__"

[tools]
java  = "__JAVA_VERSION__"
maven = "latest"

[tasks.dev]
description = "Spring Boot em dev (perfil dev)"
run = "./mvnw -B spring-boot:run"

[tasks.test]
description = "Testes"
run = "./mvnw -B test"

[tasks.lint]
description = "Análise estática (verify, skipTests)"
run = "./mvnw -B verify -DskipTests"

[tasks.qa]
description = "Pipeline QA: clean + test + verify"
run = """
./mvnw -B clean
./mvnw -B test
./mvnw -B verify
"""

[tasks.db-up]
description = "Sobe Postgres via compose"
run = "docker compose -f docker/docker-compose.yml up -d db"

[tasks.db-down]
description = "Derruba Postgres"
run = "docker compose -f docker/docker-compose.yml down db"

[tasks.docker-up]
description = "Sobe stack completa (app + db)"
run = "docker compose -f docker/docker-compose.yml up --build"

[tasks.docker-down]
description = "Derruba stack completa"
run = "docker compose -f docker/docker-compose.yml down -v"
