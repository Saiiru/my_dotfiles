#!/usr/bin/env bash
set -euo pipefail

STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/neon-niri/system-context"

get_context() {
    [[ -f "$STATE_FILE" ]] && tr -d '\r' < "$STATE_FILE" || echo "UNKNOWN"
}

get_cpu_usage() {
    top -bn1 | awk '/Cpu\(s\)/ {print 100 - $8 "%"}' 2>/dev/null || echo "N/A"
}

get_cpu_temp() {
    if command -v sensors >/dev/null 2>&1; then
        sensors 2>/dev/null | awk '/Package id 0/ {gsub("+", ""); print $4; exit}' || echo "N/A"
    else
        echo "N/A"
    fi
}

get_cpu_freq() {
    awk -F: '/cpu MHz/ {print $2; exit}' /proc/cpuinfo 2>/dev/null | awk '{printf "%.2f GHz", $1/1000}' || echo "N/A"
}

get_gpu_usage() {
    if command -v nvidia-smi >/dev/null 2>&1; then
        nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>/dev/null || echo "N/A"
    elif [[ -f /sys/class/drm/card0/device/gpu_busy_percent ]]; then
        cat /sys/class/drm/card0/device/gpu_busy_percent 2>/dev/null || echo "N/A"
    else
        echo "N/A"
    fi
}

get_gpu_temp() {
    if command -v nvidia-smi >/dev/null 2>&1; then
        nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits 2>/dev/null || echo "N/A"
    elif [[ -f /sys/class/drm/card0/device/hwmon/hwmon0/temp1_input ]]; then
        awk '{printf "%.0f", $1/1000}' /sys/class/drm/card0/device/hwmon/hwmon*/temp1_input 2>/dev/null || echo "N/A"
    else
        echo "N/A"
    fi
}

get_ram_usage() {
    free | awk '/Mem:/ {printf "%.1f%%", ($3/$2)*100}' 2>/dev/null || echo "N/A"
}

print_header() {
    clear
    echo "═══════════════════════════════════════════════════════"
    echo "  NEON-NIRI Performance Monitor"
    echo "  Ctrl+C to exit"
    echo "═══════════════════════════════════════════════════════"
    echo
}

run_loop() {
    print_header
    while true; do
        tput cup 4 0
        printf "Context:      %s\n" "$(get_context)"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        printf "CPU Usage:    %s\n" "$(get_cpu_usage)"
        printf "CPU Temp:     %s\n" "$(get_cpu_temp)"
        printf "CPU Freq:     %s\n" "$(get_cpu_freq)"
        echo
        printf "GPU Usage:    %s\n" "$(get_gpu_usage)"
        printf "GPU Temp:     %s\n" "$(get_gpu_temp)"
        echo
        printf "RAM Usage:    %s\n" "$(get_ram_usage)"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        sleep 1
    done
}

run_loop
