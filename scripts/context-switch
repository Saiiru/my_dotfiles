#!/usr/bin/env bash
#
# NEON-NIRI · Context Switch Engine
# ---------------------------------
# Controls system performance profiles (DEFAULT / DEV / GAME),
# generates the active Niri configuration and reloads the compositor.

set -euo pipefail

VERSION="2.0.0"

# ────────────────────────────────────────────────────────────────────
# Paths (XDG aware)
# ────────────────────────────────────────────────────────────────────

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

NIRI_CONFIG_DIR="${XDG_CONFIG_HOME}/niri"
BASE_CONFIG="${NIRI_CONFIG_DIR}/base.kdl"
DEV_CONFIG="${NIRI_CONFIG_DIR}/dev-mode.kdl"
GAME_CONFIG="${NIRI_CONFIG_DIR}/game-mode.kdl"
ACTIVE_CONFIG="${NIRI_CONFIG_DIR}/config.kdl.active"
CONFIG_SYMLINK="${NIRI_CONFIG_DIR}/config.kdl"

STATE_DIR="${XDG_STATE_HOME}/neon-niri"
STATE_FILE="${STATE_DIR}/system-context"
LOG_FILE="${STATE_DIR}/context-switch.log"
LOCK_FILE="${STATE_DIR}/context-switch.lock"

CPU_GOV_PATH="/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor"

VALID_CONTEXTS=("DEFAULT" "DEV" "GAME")

# ────────────────────────────────────────────────────────────────────
# Helpers
# ────────────────────────────────────────────────────────────────────

log() {
    local level="$1"; shift
    local msg="$*"
    local ts
    ts="$(date '+%Y-%m-%d %H:%M:%S')"
    mkdir -p "$STATE_DIR"
    printf '[%s] [%s] %s\n' "$ts" "$level" "$msg" >> "$LOG_FILE"

    case "$level" in
        INFO) printf '\e[34m[INFO]\e[0m %s\n' "$msg" ;;
        OK) printf '\e[32m[ OK ]\e[0m %s\n' "$msg" ;;
        WARN) printf '\e[33m[WARN]\e[0m %s\n' "$msg" ;;
        ERROR) printf '\e[31m[ERR]\e[0m %s\n' "$msg" ;;
    esac
}

notify() {
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send "$1" "$2" -i "${3:-dialog-information}" -t 2500 || true
}

die() {
    log ERROR "$*"
    exit 1
}

ensure_symlink() {
    if [[ ! -L "$CONFIG_SYMLINK" ]] || [[ "$(readlink "$CONFIG_SYMLINK")" != "config.kdl.active" ]]; then
        ln -sfn "config.kdl.active" "$CONFIG_SYMLINK"
    fi
}

require_files() {
    for file in "$BASE_CONFIG" "$DEV_CONFIG" "$GAME_CONFIG"; do
        [[ -f "$file" ]] || die "Missing config file: $file"
    done
}

current_context() {
    if [[ -f "$STATE_FILE" ]]; then
        cat "$STATE_FILE"
    else
        echo "DEFAULT"
    fi
}

write_state() {
    mkdir -p "$STATE_DIR"
    printf '%s\n' "$1" > "$STATE_FILE"
}

# ────────────────────────────────────────────────────────────────────
# Locking (flock)
# ────────────────────────────────────────────────────────────────────

acquire_lock() {
    exec 9>"$LOCK_FILE"
    if ! flock -n 9; then
        die "context-switch already running"
    fi
}

# ────────────────────────────────────────────────────────────────────
# CPU governor helpers
# ────────────────────────────────────────────────────────────────────

set_cpu_governor() {
    local governor="$1"
    if [[ ! -w "$CPU_GOV_PATH" ]]; then
        log INFO "Setting CPU governor (sudo required): $governor"
        echo "$governor" | sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor >/dev/null
    else
        log INFO "Setting CPU governor: $governor"
        echo "$governor" > /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor
    fi
    log OK "CPU governor set to $governor"
}

# ────────────────────────────────────────────────────────────────────
# GameMode helpers
# ────────────────────────────────────────────────────────────────────

gamemode_start() {
    if systemctl --user is-active --quiet gamemoded; then
        gamemoded -r >/dev/null 2>&1 || true
    else
        systemctl --user start gamemoded >/dev/null 2>&1 || true
    fi
}

gamemode_stop() {
    systemctl --user stop gamemoded >/dev/null 2>&1 || true
}

# ────────────────────────────────────────────────────────────────────
# Config generation
# ────────────────────────────────────────────────────────────────────

build_config() {
    local context="$1"
    ensure_symlink
    require_files

    cp "$BASE_CONFIG" "$ACTIVE_CONFIG"
    case "$context" in
        DEV) cat "$DEV_CONFIG" >> "$ACTIVE_CONFIG" ;;
        GAME) cat "$GAME_CONFIG" >> "$ACTIVE_CONFIG" ;;
    esac
    log OK "Generated Niri config for $context"
}

reload_niri() {
    if ! niri msg reload-config >/dev/null 2>&1; then
        die "Failed to reload Niri configuration"
    fi
    log OK "Niri configuration reloaded"
}

# ────────────────────────────────────────────────────────────────────
# Context application
# ────────────────────────────────────────────────────────────────────

apply_default() {
    set_cpu_governor "schedutil"
    gamemode_stop
    build_config "DEFAULT"
    write_state "DEFAULT"
    reload_niri
    notify "System Context" "Default mode activated" "user-home"
}

apply_dev() {
    set_cpu_governor "schedutil"
    gamemode_stop
    build_config "DEV"
    write_state "DEV"
    reload_niri
    notify "System Context" "Development mode activated" "applications-development"
}

apply_game() {
    set_cpu_governor "performance"
    gamemode_start
    build_config "GAME"
    write_state "GAME"
    reload_niri
    notify "System Context" "Gaming mode activated" "applications-games"
}

transition_to() {
    local target="$1"
    local current
    current="$(current_context)"
    log INFO "Transition: $current → $target"

    # Force pass through DEFAULT when switching DEV↔GAME
    if [[ "$current" == "DEV" && "$target" == "GAME" ]] || \
       [[ "$current" == "GAME" && "$target" == "DEV" ]]; then
        apply_default
    fi

    case "$target" in
        DEFAULT) apply_default ;;
        DEV) apply_dev ;;
        GAME) apply_game ;;
    esac

    log OK "Context switched to $target"
}

# ────────────────────────────────────────────────────────────────────
# CLI
# ────────────────────────────────────────────────────────────────────

print_status() {
    local ctx
    ctx="$(current_context)"
    cat <<EOF
NEON-NIRI Context Switch v$VERSION
Current context : $ctx
Active config   : $ACTIVE_CONFIG
State file      : $STATE_FILE
Log file        : $LOG_FILE
EOF
}

print_help() {
    cat <<EOF
NEON-NIRI context switcher v$VERSION

Usage:
  context-switch <default|dev|game>
  context-switch status
  context-switch help
EOF
}

main() {
    local cmd="${1:-}"
    [[ -n "$cmd" ]] || { print_help; exit 1; }

    case "$cmd" in
        help|-h|--help) print_help; exit 0 ;;
        status) print_status; exit 0 ;;
        version|-v|--version) echo "$VERSION"; exit 0 ;;
    esac

    local target
    target="$(printf '%s' "$cmd" | tr '[:lower:]' '[:upper:]')"
    [[ " ${VALID_CONTEXTS[*]} " =~ " ${target} " ]] || die "Invalid context: $cmd"

    acquire_lock
    transition_to "$target"
}

main "$@"
